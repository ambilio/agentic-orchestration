# ~/agentic-lab/.env — set these in the sandbox root
#
# Verify what's already present:
#   cat ~/agentic-lab/.env
#
# Add any missing lines with tee or your editor.

# LLM gateway (usually set by sandbox provisioning)
OPENROUTER_API_KEY=<your-key-here>

# PostgreSQL checkpointer — often missing from a fresh sandbox
DATABASE_URL=postgresql://labuser:labpass@localhost:5432/agentdb

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your-langsmith-key>
LANGSMITH_PROJECT=agentic-lab

# Claude Agent SDK — redirect Anthropic SDK to OpenRouter
# (Lab 2 sets these programmatically if missing here)
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_AUTH_TOKEN=<same as OPENROUTER_API_KEY>
ANTHROPIC_MODEL=anthropic/claude-sonnet-4.5
